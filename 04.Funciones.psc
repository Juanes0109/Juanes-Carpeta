Algoritmo Funciones 
	definir num, seno, coseno, tangente, rai, logaritmoNatural, logaritmo10 Como Real
	Escribir " Escribe el numero "
	Leer num
	seno = sen(num)
	coseno = cos(num)
	tangente = tan(num)
	rai = rc(num)
	logaritmoNatural = ln(num)
	logaritmo10 = ln(num)/ln(10)
	Escribir " El seno de el numero es " seno
	Escribir " El coseno de el numero es " coseno
	Escribir " La tangente de el numero es " tangente
	Escribir " La raiz de el numero es " rai
	Escribir " El Logaritmo natural de el numero es " logaritmoNatural
	Escribir " El Logaritmo 10 de el numero es " logaritmo10

	
FinAlgoritmo
