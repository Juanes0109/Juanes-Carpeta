Algoritmo CALCULADORAPROMEDIAL
	definir n1,n2,n3,n4 Como Real
	Escribir " digame el valor de sus notas "
	Escribir "Dame la nota 1"
	Leer n1
	Escribir "Dame la nota 2"
	Leer n2
	Escribir "Dame la nota 3"
	Leer n3
	Escribir "Dame la nota 4"
	Leer n4
	Promedio<-(n1+n2+n3+n4)/4
	Escribir " tu promedio de notas es " Promedio
FinAlgoritmo
